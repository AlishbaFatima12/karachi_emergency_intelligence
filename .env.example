# ═══════════════════════════════════════════════════════════════════
# SENTINEL-K CONFIGURATION
# Copy this file to .env and fill in your API keys
# ═══════════════════════════════════════════════════════════════════

# === REQUIRED APIs ===

# OpenWeatherMap (FREE: 1000 calls/day)
# Get key: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# Brave Search (FREE: 2000 queries/month)
# Get key: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here


# === OPTIONAL: TELEGRAM NOTIFICATIONS ===

# Step 1: Create bot with @BotFather on Telegram
# Step 2: Get bot token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Step 3: Create channel/group, add bot as admin
# Step 4: Get chat_id (use @userinfobot or @getidsbot)
TELEGRAM_CHAT_ID=your_chat_id_here


# === OPTIONAL: GOOGLE MAPS ===

# For proximity analysis (nearest hospital, traffic)
# Get key: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_key_here


# === SYSTEM SETTINGS ===

# Vault storage path (default: Sentinel_Vault in project root)
SENTINEL_VAULT_PATH=Sentinel_Vault

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Web dashboard port
DASHBOARD_PORT=8000


# === POLLING INTERVALS (seconds) ===

RSS_POLL_INTERVAL=300
WEATHER_POLL_INTERVAL=900
SOCIAL_POLL_INTERVAL=300
